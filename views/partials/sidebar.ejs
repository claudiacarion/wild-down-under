<div class="sidebar__button-container">
  <button class="sidebar__arrow">&#9662;</button>
</div>
<aside class="sidebar">

  <% if (locals.animalArray) { %>
    <div class="sidebar-wrapper">
      <h3 class="sidebar__title">
        <%= groupName %>
      </h3>
      <ul class="sidebar__ul">
        <% animalArray.forEach(animal=> { %>
          <li class="sidebar__li">
            <a href="/<%=animal.group.toLowerCase()%>/<%= animal.slug%>">
              <%= animal.name %>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
    <% } %>

      <% if (locals.teamArray) { %>
        <div class="sidebar-wrapper">
          <h3 class="sidebar__title">
            <%= teamName %>
          </h3>
          <ul class="sidebar__ul">
            <% teamArray.forEach(member=> { %>
              <li class="sidebar__li">
                <a href="/aboutus/<%= member.slug%>">
                  <%= member.name %>
                </a>
              </li>
              <% }) %>
          </ul>
        </div>
        <% } %>
            <% if (locals.allAnimalsArray) { %>
            <% allAnimalsArray.forEach(group=> { %>
              <div class="sidebar-wrapper">
                <h3 class="sidebar__title">
                  <%= group.name %>
                </h3>
                <ul class="sidebar__ul">
                  <% group.animals.forEach(animal=> { %>
                    <li class="sidebar__li">
                      <a href="/home/<%= animal.slug %>">
                        <%= animal.name %>
                      </a>
                    </li>
                    <% }) %>
                </ul>
              </div>
              <% })} %>
</aside>