<% if(locals.groupName) { %>
  <% animals.forEach(animal => { %>
    <div>
      <h2><%= animal.name %></h2>
      <h3><%= animal.group %></h3>
    </div>
    <div>
      <p><%= animal.description %></p>
      <p>Diet: <%= animal.diet %></p>
      <p>Lifespan: <%= animal.lifespan %></p>
      <p>Location: <%= animal.location %></p>
      <p>Length: <%= animal.length %></p>
      <p>Weight: <%= animal.weight %></p>
    </div>
    <img src="<%= animal.image %>" alt="<%= animal.name %>">
  </div>
<%})%>
<%} else if(locals.teamName) { %>
  <% team.forEach(member => { %>
    <div>
      <h2><%= member.name %></h2>
    </div>
    <div>
      <img src="<%= member.image %>" alt="<%= member.name %>">
      <p>Ability: <%= member.specialAbility %></p>
      <p>Habitat: <%= member.habitat %></p>
      <a href="<%= member.github %>"><i class="fa-brands fa-github"></i></a>
      <a href="<%= member.linkedIn %>"><i class="fa-brands fa-square-linkedin"></i></a>
    </div>
  <%})%>
<%}%>
